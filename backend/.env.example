# LLM Smash Bros — Fighter API Configuration
# Copy this file to .env and fill in your keys:
#   cp .env.example .env
#
# Each fighter slot (FIGHTER1 / FIGHTER2) is independently configurable.
# PROVIDER must be "openai" or "anthropic" (OpenRouter uses "openai" protocol).
# BASE_URL is optional — leave empty to use the provider's official endpoint.

# ── Fighter 1 (left side, default: The Oracle / GPT-4o) ──────────────
FIGHTER1_PROVIDER=openai
FIGHTER1_API_KEY=sk-...
FIGHTER1_MODEL=gpt-4o
FIGHTER1_BASE_URL=

# ── Fighter 2 (right side, default: The Artisan / Claude) ────────────
FIGHTER2_PROVIDER=anthropic
FIGHTER2_API_KEY=sk-ant-...
FIGHTER2_MODEL=claude-sonnet-4-5-20250929
FIGHTER2_BASE_URL=

# ── Example: Both fighters via OpenRouter ────────────────────────────
# OpenRouter model IDs use "org/model" format. Find IDs at https://openrouter.ai/models
# FIGHTER1_PROVIDER=openai
# FIGHTER1_API_KEY=sk-or-...
# FIGHTER1_MODEL=qwen/qwen3.6-plus:free
# FIGHTER1_BASE_URL=https://openrouter.ai/api/v1
#
# FIGHTER2_PROVIDER=openai
# FIGHTER2_API_KEY=sk-or-...
# FIGHTER2_MODEL=minimax/minimax-m2.5
# FIGHTER2_BASE_URL=https://openrouter.ai/api/v1

# ── Example: Custom proxy / Azure ────────────────────────────────────
# FIGHTER1_PROVIDER=openai
# FIGHTER1_API_KEY=your-azure-key
# FIGHTER1_MODEL=gpt-4o
# FIGHTER1_BASE_URL=https://your-resource.openai.azure.com/v1
